export EDITOR=hx
export VISUAL=hx
export PATH="~/.local/bin:$PATH"
source "$HOME/.cargo/env"
export PATH="~/.juliaup/bin:~/.julia/bin:$PATH"
[ -f "~/.julia/juliaup/completions/bash.sh" ] && source "~/.julia/juliaup/completions/bash.sh"

# guard non-interactive shell and early execution
[[ $- != *i* ]] && return

# If running interactively, flush any unread DA responses or handshake debris
if [[ $- == *i* ]] && [ -t 0 ]; then
    read -t 0.05 -n 1000 -s _ < /dev/tty 2>/dev/null || true
fi

{{- if .is_desktop }}
export SSH_AUTH_SOCK=/home/lcwllmr/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock
{{- else }}
if [ -z "$SSH_AUTH_SOCK" ] || ! ssh-add -l >/dev/null 2>&1; then
    eval "$(ssh-agent -s)" >/dev/null
fi
{{- end }}

set -o vi
# Plain DECSCUSR escapes — works both inside tmux and naked outside tmux
# Readline 4.4+ requires \1 and \2 around non-printing escape sequences
bind 'set show-mode-in-prompt on'
bind 'set vi-ins-mode-string \1\e[6 q\2'
bind 'set vi-cmd-mode-string \1\e[2 q\2'
source {{ .gitprompt }}
function build_prompt() {
  local location_part=""
  if [[ -n "$SSH_CONNECTION" ]]; then
      location_part+="$(printf "%s@%s:" "$USER" "$HOSTNAME")"
  fi
  location_part+="\w"

  GIT_PS1_SHOWDIRTYSTATE="1"
  GIT_PS1_SHOWSTASHSTATE="1"
  GIT_PS1_SHOWUNTRACKEDFILES="1"
  GIT_PS1_SHOWUPSTREAM="auto"
  git_part="$(__git_ps1 " (%s)")"

  green='\[\033[1;32m\]'
  reset='\[\033[0m\]'
  PS1="${green}[ ${location_part}${git_part} ]\$${reset} "
}
PROMPT_COMMAND=build_prompt

